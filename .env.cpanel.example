# ==============================================================================
# KONFIGURASI OTOMATISASI DEPLOY DARI ANTIGRAVITY KE CPANEL
# ==============================================================================
# Salin file ini menjadi .env.cpanel dan isi dengan akun cPanel Anda:
# (Informasi ini ada di cPanel > "FTP Accounts" atau akun utama cPanel Anda)

# 1. Alamat Host FTP (Bisa nama domain Anda, e.g. ftp.domainanda.com atau IP server)
CPANEL_FTP_HOST=ftp.domainanda.com

# 2. Username FTP cPanel Anda
CPANEL_FTP_USER=username@domainanda.com

# 3. Password akun cPanel atau FTP Anda
CPANEL_FTP_PASSWORD=password_cpanel_anda

# 4. Port FTP (Standar 21 untuk FTP, atau 22 jika SFTP)
CPANEL_FTP_PORT=21

# 5. Folder tujuan di cPanel (Standar web utama adalah public_html)
CPANEL_REMOTE_DIR=public_html

# 6. Keamanan koneksi (true jika server mendukung FTPS/TLS, false jika FTP biasa)
CPANEL_FTP_SECURE=false
