# ==============================================================================
# TADRIBUL LUGHAH — KONFIGURASI APACHE UNTUK CPANEL (public_html/.htaccess)
# ==============================================================================

# 1. UTF-8 Charset untuk Teks Bahasa Arab & Terjemahan
AddDefaultCharset UTF-8
IndexOptions +Charset=UTF-8

# 2. Aktifkan Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Opsional: Paksa HTTPS jika SSL aktif di cPanel
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrites untuk URL bersih tanpa .html (opsional & memudahkan navigasi)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# 3. Kompresi Gzip untuk Kecepatan Loading di cPanel
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 4. Cache Control untuk Aset Statis
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Keamanan Tambahan
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Lindungi file konfigurasi rahasia API key agar tidak bisa diakses langsung dari browser
<Files "gemini_config.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
